#pragma once

// Token mirror of the canonical C++ formulas in VoxelPaintBrushMath.h/.cpp; keep in lockstep.

float3 WVPBrushSafeNormal(float3 V)
{
	const float SquareSum = dot(V, V);
	if (SquareSum < 1.e-8f)
	{
		return float3(0.0f, 0.0f, 0.0f);
	}
	return V * rsqrt(SquareSum);
}

bool WVPBrushIsNearlyZero(float3 V)
{
	return all(abs(V) <= 1.e-4f);
}

bool PassesRadius(float DistWorld, float RadiusWorld)
{
	return DistWorld <= RadiusWorld;
}

bool PassesFlatten(float SignedDepthWorld, float RadiusWorld, float FlattenPct, float MinFlattenDepthWorld)
{
	const float MaxDepth = max(RadiusWorld * (1.0f - clamp(FlattenPct, 0.0f, 1.0f)), MinFlattenDepthWorld);
	return abs(SignedDepthWorld) <= MaxDepth;
}

bool PassesAngle(float3 SurfaceNormal, float3 BrushNormal, float AngleToleranceDeg)
{
	const float3 Surface = WVPBrushSafeNormal(SurfaceNormal);
	const float3 Brush = WVPBrushSafeNormal(BrushNormal);
	if (WVPBrushIsNearlyZero(Surface) || WVPBrushIsNearlyZero(Brush))
	{
		return true;
	}
	const float CosTolerance = cos(radians(clamp(AngleToleranceDeg, 0.0f, 180.0f)));
	return dot(Surface, Brush) >= CosTolerance;
}

float FalloffWeight(float DistTexels, float RadiusTexels, float FalloffHotspot)
{
	const float Hotspot = clamp(FalloffHotspot, 0.0f, 1.0f) * RadiusTexels;
	if (DistTexels <= Hotspot)
	{
		return 1.0f;
	}
	return 1.0f - clamp((DistTexels - Hotspot) / max(RadiusTexels - Hotspot, 0.0001f), 0.0f, 1.0f);
}
